<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.jreact.examples</groupId>
        <artifactId>library</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>library-server</artifactId>
    <name>library-server</name>
    <description>Spring Boot: the API, and the built client (served by jreact-spring-boot-starter). `mvn package` gives one runnable jar.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>library-shared</artifactId></dependency>
        <!-- the built UI (jreact/index.html, jreact/assets/...) and its classes for server side rendering. Its own dependencies (TeaVM, jreact-web) are for the browser, not for this JVM -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>library-client</artifactId>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency><groupId>dev.jreact</groupId><artifactId>jreact-spring-boot-starter</artifactId><version>${jreact.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <!-- the database: Spring Data JPA on H2 (in memory). Swap the H2 line for PostgreSQL/MySQL and set spring.datasource.* for a real one -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-devtools</artifactId><scope>runtime</scope><optional>true</optional></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
