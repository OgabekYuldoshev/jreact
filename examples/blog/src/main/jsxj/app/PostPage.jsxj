package app;

import java.util.Map;
import jreact.Component;
import jreact.Element;
import jreact.router.Link;
import jreact.router.Navigator;
import static jreact.router.RouterHooks.*;

/** /posts/:id. An id with no post renders its own "not found" instead of the app-wide 404. */
public class PostPage extends Component<PostPage.Props> {

    public record Props() {}

    @Override
    public Element render(Props props) {
        Map<String, String> params = useParams();
        Navigator go = useNavigate();
        Post post = Posts.find(params.get("id"));

        if (post == null) {
            return (
                <div id="page-post-missing">
                    <h1 className="text-2xl font-bold">No post "{params.get("id")}"</h1>
                    <Link to="/posts" className="mt-4 inline-block text-indigo-600 hover:underline">All posts</Link>
                </div>
            );
        }
        Post prev = Posts.find(String.valueOf(post.id() - 1));
        Post next = Posts.find(String.valueOf(post.id() + 1));
        return (
            <article id="page-post">
                <button id="back" className="text-sm text-stone-500 hover:text-stone-900" onClick={e -> go.back()}>← Back</button>
                <p className="mt-6 text-xs font-medium uppercase text-indigo-600">{post.tag()} · {post.date()} · {post.minutes()} min</p>
                <h1 id="post-title" className="mt-2 text-4xl font-extrabold tracking-tight">{post.title()}</h1>
                <p className="mt-6 text-lg leading-relaxed text-stone-700">{post.body()}</p>
                <div className="mt-12 flex justify-between border-t border-stone-200 pt-6 text-sm">
                    {prev != null ? <Link id="prev" to={"../" + prev.id()} className="text-indigo-600 hover:underline">← {prev.title()}</Link> : <span></span>}
                    {next != null ? <Link id="next" to={"../" + next.id()} className="text-indigo-600 hover:underline">{next.title()} →</Link> : <span></span>}
                </div>
            </article>
        );
    }
}
