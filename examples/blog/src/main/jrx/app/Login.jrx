package app;

import jreact.Component;
import jreact.Element;
import jreact.State;
import jreact.router.Navigator;
import static jreact.router.RouterHooks.*;

public class Login extends Component<Login.Props> {

    public record Props() {}

    @Override
    public Element render(Props props) {
        Auth auth = useContext(Auth.CONTEXT);
        Navigator go = useNavigate();
        String next = useSearchParams().params().get("next", "/account");
        State<String> name = useState("");

        return (
            <div id="page-login" className="mx-auto max-w-sm">
                <h1 className="text-3xl font-bold tracking-tight">Sign in</h1>
                <p className="mt-2 text-sm text-stone-500">Any name works. You will land on <code id="next-path">{next}</code>.</p>
                <form id="login-form" className="mt-6 space-y-4"
                      onSubmit={e -> {
                          e.preventDefault();
                          if (name.get().isBlank()) return;
                          auth.signIn().accept(name.get().trim());
                          go.navigate(next, true);
                      }}>
                    <input id="username" placeholder="Your name" value={name.get()} onInput={e -> name.set(e.value())}
                           className="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 outline-none focus:border-indigo-500" />
                    <button type="submit" className="w-full rounded-lg bg-indigo-600 px-4 py-2.5 font-medium text-white hover:bg-indigo-700">Sign in</button>
                </form>
            </div>
        );
    }
}
