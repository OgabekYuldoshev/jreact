package app;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import jreact.Component;
import jreact.Element;
import jreact.State;

/** The whole board: owns the task list and hands callbacks down to the columns. */
public class Board extends Component<Board.Props> {

    public record Props() {}

    static final String[] COLUMNS = {"To do", "In progress", "Done"};

    @Override
    public Element render(Props props) {
        State<List<Task>> tasks = useState(Seed.tasks());
        State<Long> nextId = useState(100L);

        long total = tasks.get().size();
        long done = tasks.get().stream().filter(t -> t.column() == 2).count();
        int pct = total == 0 ? 0 : (int) (done * 100 / total);

        return (
            <div className="mx-auto max-w-6xl px-4 py-8">
                <header className="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <h1 className="text-2xl font-bold tracking-tight">Product board</h1>
                        <p className="mt-1 text-sm text-slate-500">{done} of {total} tasks done</p>
                    </div>
                    <div className="w-full sm:w-64">
                        <div className="h-2 overflow-hidden rounded-full bg-slate-200">
                            <div id="progress" className="h-full rounded-full bg-emerald-500 transition-all duration-300"
                                 style={Map.of("width", pct + "%")}></div>
                        </div>
                        <p className="mt-1 text-right text-xs font-medium text-slate-500">{pct}%</p>
                    </div>
                </header>

                <div className="grid gap-4 md:grid-cols-3">
                    {List.of(0, 1, 2).stream().map(i ->
                        <Column key={i} title={COLUMNS[i]} index={i}
                                tasks={tasks.get().stream().filter(t -> t.column() == i).toList()}
                                onMove={(id, delta) -> tasks.update(list -> move(list, id, delta))}
                                onDelete={id -> tasks.update(list -> remove(list, id))} />
                    ).toList()}
                </div>

                <AddTask onAdd={(title, tag) -> add(tasks, nextId, title, tag)} />
            </div>
        );
    }

    private static void add(State<List<Task>> tasks, State<Long> nextId, String title, String tag) {
        long id = nextId.get();
        nextId.set(id + 1);
        List<Task> next = new ArrayList<>(tasks.get());
        next.add(new Task(id, title, tag, 0));
        tasks.set(next);
    }

    private static List<Task> move(List<Task> list, long id, int delta) {
        return list.stream().map(t -> t.id() == id ? t.moved(delta) : t).toList();
    }

    private static List<Task> remove(List<Task> list, long id) {
        return list.stream().filter(t -> t.id() != id).toList();
    }
}
