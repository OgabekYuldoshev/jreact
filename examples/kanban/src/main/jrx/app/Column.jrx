package app;

import java.util.List;
import java.util.function.BiConsumer;
import java.util.function.Consumer;
import jreact.Component;
import jreact.Element;

/** One column of the board: a title, a counter and its cards. */
public class Column extends Component<Column.Props> {

    public record Props(String title, int index, List<Task> tasks,
                        BiConsumer<Long, Integer> onMove, Consumer<Long> onDelete) {}

    @Override
    public Element render(Props props) {
        return (
            <section className="flex flex-col rounded-2xl bg-slate-200/60 p-3" data-column={props.index()}>
                <div className="mb-3 flex items-center justify-between px-1">
                    <h2 className="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-600">
                        <span className={"h-2.5 w-2.5 rounded-full " + dot(props.index())}></span>
                        {props.title()}
                    </h2>
                    <span className="count rounded-full bg-white px-2 py-0.5 text-xs font-medium text-slate-500">{props.tasks().size()}</span>
                </div>
                <div className="flex flex-1 flex-col gap-3">
                    {props.tasks().isEmpty()
                        ? <p className="rounded-xl border-2 border-dashed border-slate-300 p-6 text-center text-sm text-slate-400">Nothing here yet</p>
                        : null}
                    {props.tasks().stream().map(t ->
                        <TaskCard key={t.id()} task={t}
                                  canLeft={props.index() > 0} canRight={props.index() < 2}
                                  onMove={props.onMove()} onDelete={props.onDelete()} />
                    ).toList()}
                </div>
            </section>
        );
    }

    private static String dot(int index) {
        return switch (index) {
            case 0 -> "bg-sky-500";
            case 1 -> "bg-amber-500";
            default -> "bg-emerald-500";
        };
    }
}
