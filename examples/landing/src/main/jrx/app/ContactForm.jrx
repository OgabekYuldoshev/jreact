package app;

import jreact.Component;
import jreact.Element;
import jreact.State;

/** Controlled form with validation: errors appear after the first submit attempt and then update live. */
public class ContactForm extends Component<ContactForm.Props> {

    public record Props() {}

    @Override
    public Element render(Props props) {
        State<String> name = useState("");
        State<String> email = useState("");
        State<String> message = useState("");
        State<Boolean> tried = useState(false);
        State<Boolean> sent = useState(false);

        String nameError = name.get().isBlank() ? "Please enter your name" : null;
        String emailError = validEmail(email.get()) ? null : "Enter a valid email address";
        String messageError = message.get().trim().length() < 10 ? "Tell us a bit more (at least 10 characters)" : null;
        boolean valid = nameError == null && emailError == null && messageError == null;

        return (
            <section id="contact" className="bg-gradient-to-b from-white to-violet-50 py-20">
                <div className="mx-auto max-w-xl px-6">
                    <h2 className="text-center text-3xl font-bold tracking-tight sm:text-4xl">Talk to us</h2>
                    <p className="mt-3 text-center text-slate-600">Questions, a demo or a custom plan? We reply within one business day.</p>

                    {sent.get()
                        ? <div id="success" className="mt-10 rounded-2xl bg-white p-10 text-center shadow-sm ring-1 ring-emerald-200">
                              <div className="text-5xl">✅</div>
                              <h3 className="mt-4 text-xl font-bold">Message sent</h3>
                              <p className="mt-2 text-slate-600">Thanks {name.get()}, we will write to {email.get()} soon.</p>
                              <button id="again" className="mt-6 rounded-full px-5 py-2 text-sm font-semibold text-indigo-600 ring-1 ring-indigo-200 hover:bg-indigo-50"
                                      onClick={e -> { name.set(""); email.set(""); message.set(""); tried.set(false); sent.set(false); }}>Send another</button>
                          </div>
                        : <form id="contact-form" className="mt-10 space-y-5 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200"
                                onSubmit={e -> { e.preventDefault(); tried.set(true); if (valid) sent.set(true); }}>
                              <Field id="name" label="Name" value={name.get()} error={tried.get() ? nameError : null}
                                     onInput={v -> name.set(v)} />
                              <Field id="email" label="Email" value={email.get()} error={tried.get() ? emailError : null}
                                     onInput={v -> email.set(v)} />
                              <Field id="message" label="Message" value={message.get()} error={tried.get() ? messageError : null}
                                     multiline={true} onInput={v -> message.set(v)} />
                              <button type="submit" className="w-full rounded-full bg-indigo-600 py-3 font-semibold text-white hover:bg-indigo-500">Send message</button>
                          </form>}
                </div>
            </section>
        );
    }

    private static boolean validEmail(String s) {
        int at = s.indexOf('@');
        return at > 0 && s.indexOf('.', at) > at + 1 && !s.endsWith(".") && !s.contains(" ");
    }
}
