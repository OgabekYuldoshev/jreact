package app;

import java.util.List;
import jreact.Component;
import jreact.Element;
import jreact.State;

/** Sticky top bar. On small screens the links collapse behind a menu button. */
public class Navbar extends Component<Navbar.Props> {

    public record Props() {}

    static final List<String> LINKS = List.of("Features", "Pricing", "FAQ", "Contact");

    @Override
    public Element render(Props props) {
        State<Boolean> open = useState(false);

        return (
            <header className="sticky top-0 z-20 border-b border-slate-200 bg-white/80 backdrop-blur">
                <div className="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                    <a href="#top" className="flex items-center gap-2 text-lg font-bold">
                        <span className="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-violet-600 to-indigo-600 text-white">F</span>
                        Flowly
                    </a>
                    <nav className="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
                        {LINKS.stream().map(l ->
                            <a key={l} href={"#" + l.toLowerCase()} className="hover:text-slate-900">{l}</a>
                        ).toList()}
                        <a href="#contact" className="rounded-full bg-slate-900 px-4 py-2 text-white hover:bg-slate-700">Get started</a>
                    </nav>
                    <button id="menu-button" className="rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden"
                            onClick={e -> open.update(o -> !o)}>{open.get() ? "✕" : "☰"}</button>
                </div>
                {open.get()
                    ? <nav id="mobile-menu" className="flex flex-col gap-1 border-t border-slate-200 px-6 py-3 md:hidden">
                          {LINKS.stream().map(l ->
                              <a key={l} href={"#" + l.toLowerCase()} className="rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100"
                                 onClick={e -> open.set(false)}>{l}</a>
                          ).toList()}
                      </nav>
                    : null}
            </header>
        );
    }
}
