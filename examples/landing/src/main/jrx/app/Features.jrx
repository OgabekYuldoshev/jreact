package app;

import java.util.List;
import jreact.Component;
import jreact.Element;

/** Six feature cards in a responsive grid. */
public class Features extends Component<Features.Props> {

    public record Props() {}

    record Feature(String icon, String title, String text) {}

    static final List<Feature> ITEMS = List.of(
        new Feature("⚡", "Instant triggers", "React to events from 200+ apps within milliseconds."),
        new Feature("🧩", "Visual builder", "Drag steps together and see exactly what will run."),
        new Feature("🔒", "Secure by default", "SOC 2 audited, with role based access and an audit log."),
        new Feature("📈", "Built-in analytics", "Know which flows save time and which ones fail."),
        new Feature("🤝", "Team workspaces", "Share flows, review changes and comment in context."),
        new Feature("🛠️", "Open API", "Extend Flowly with webhooks and a typed SDK.")
    );

    @Override
    public Element render(Props props) {
        return (
            <section id="features" className="mx-auto max-w-6xl px-6 py-20">
                <div className="mx-auto max-w-2xl text-center">
                    <h2 className="text-3xl font-bold tracking-tight sm:text-4xl">Everything you need to run on autopilot</h2>
                    <p className="mt-4 text-slate-600">Powerful enough for engineers, simple enough for the rest of the team.</p>
                </div>
                <div className="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {ITEMS.stream().map(f ->
                        <div key={f.title()} className="feature rounded-2xl p-6 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg">
                            <div className="grid h-12 w-12 place-items-center rounded-xl bg-violet-100 text-2xl">{f.icon()}</div>
                            <h3 className="mt-4 text-lg font-semibold">{f.title()}</h3>
                            <p className="mt-2 text-sm text-slate-600">{f.text()}</p>
                        </div>
                    ).toList()}
                </div>
            </section>
        );
    }
}
