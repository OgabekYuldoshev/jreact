package app;

import jreact.Component;
import jreact.Element;
import jreact.State;

/** Pricing section with a monthly / yearly switch shared by all plan cards. */
public class Pricing extends Component<Pricing.Props> {

    public record Props() {}

    @Override
    public Element render(Props props) {
        State<Boolean> yearly = useState(false);

        return (
            <section id="pricing" className="bg-slate-50 py-20">
                <div className="mx-auto max-w-6xl px-6">
                    <div className="mx-auto max-w-2xl text-center">
                        <h2 className="text-3xl font-bold tracking-tight sm:text-4xl">Simple, honest pricing</h2>
                        <p className="mt-4 text-slate-600">Start free for 14 days. Cancel any time.</p>
                        <div className="mt-8 inline-flex items-center gap-3 rounded-full bg-white p-1 text-sm font-medium shadow-sm ring-1 ring-slate-200">
                            <button id="bill-monthly" className={toggle(!yearly.get())} onClick={e -> yearly.set(false)}>Monthly</button>
                            <button id="bill-yearly" className={toggle(yearly.get())} onClick={e -> yearly.set(true)}>
                                Yearly <span className="ml-1 text-xs text-emerald-600">save 20%</span>
                            </button>
                        </div>
                    </div>
                    <div className="mt-12 grid items-start gap-6 lg:grid-cols-3">
                        {Plan.ALL.stream().map(p -> <PriceCard key={p.name()} plan={p} yearly={yearly.get()} />).toList()}
                    </div>
                </div>
            </section>
        );
    }

    private static String toggle(boolean active) {
        return active
            ? "rounded-full bg-indigo-600 px-5 py-2 text-white"
            : "rounded-full px-5 py-2 text-slate-600 hover:text-slate-900";
    }
}
