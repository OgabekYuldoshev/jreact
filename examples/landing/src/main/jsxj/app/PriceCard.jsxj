package app;

import jreact.Component;
import jreact.Element;

/** One plan: name, price for the chosen billing period and the feature list. */
public class PriceCard extends Component<PriceCard.Props> {

    public record Props(Plan plan, boolean yearly) {}

    @Override
    public Element render(Props props) {
        Plan p = props.plan();
        return (
            <div className={p.featured()
                ? "plan relative rounded-2xl bg-slate-900 p-8 text-white shadow-xl lg:-mt-4 lg:pb-12"
                : "plan rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200"}>
                {p.featured()
                    ? <span className="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-violet-500 to-indigo-500 px-3 py-1 text-xs font-semibold text-white">Most popular</span>
                    : null}
                <h3 className="text-lg font-semibold">{p.name()}</h3>
                <p className={p.featured() ? "text-sm text-slate-300" : "text-sm text-slate-500"}>{p.tagline()}</p>
                <p className="mt-6 flex items-baseline gap-1">
                    <span className="price text-5xl font-extrabold">${props.yearly() ? p.yearly() : p.monthly()}</span>
                    <span className={p.featured() ? "text-slate-300" : "text-slate-500"}>/month</span>
                </p>
                <p className="mt-1 h-5 text-xs text-slate-400">{props.yearly() ? "billed annually" : "billed monthly"}</p>
                <ul className="mt-6 space-y-3 text-sm">
                    {p.features().stream().map(f ->
                        <li key={f} className="flex items-center gap-2"><span className="text-emerald-500">✓</span>{f}</li>
                    ).toList()}
                </ul>
                <a href="#contact"
                   className={p.featured()
                       ? "mt-8 block rounded-full bg-white py-2.5 text-center font-semibold text-slate-900 hover:bg-slate-100"
                       : "mt-8 block rounded-full bg-slate-900 py-2.5 text-center font-semibold text-white hover:bg-slate-700"}>
                    Choose {p.name()}
                </a>
            </div>
        );
    }
}
