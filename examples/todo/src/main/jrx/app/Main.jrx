package app;

import java.util.List;
import jreact.Element;
import jreact.ServerRenderer;

public class Main {
    public static void main(String[] args) {
        List<Todo> todos = List.of(
            new Todo(1, ".jrx kompilyatorini yozish", true),
            new Todo(2, "Fiber reconciler", false),
            new Todo(3, "TeaVM bilan JS'ga build", false)
        );

        Element app = <TodoApp title="JReact Todo" initial={todos} />;

        System.out.println(ServerRenderer.renderToString(app));
    }
}
