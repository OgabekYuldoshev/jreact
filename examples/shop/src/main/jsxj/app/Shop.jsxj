package app;

import java.util.List;
import jreact.Component;
import jreact.Element;
import jreact.State;

/** The store front: search, category chips, sorting, product grid and the cart button. */
public class Shop extends Component<Shop.Props> {

    public record Props() {}

    @Override
    public Element render(Props props) {
        Cart cart = useContext(Cart.CONTEXT);
        State<String> query = useState("");
        State<String> category = useState("All");
        State<String> sort = useState("popular");
        State<Boolean> cartOpen = useState(false);

        List<Product> visible = useMemo(() -> Catalog.filter(query.get(), category.get(), sort.get()),
                query.get(), category.get(), sort.get());

        return (
            <div className="min-h-screen">
                <header className="sticky top-0 z-10 border-b border-stone-200 bg-white/90 backdrop-blur">
                    <div className="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
                        <span className="text-lg font-bold tracking-tight text-amber-800">Roast &amp; Leaf</span>
                        <input id="search" type="search" placeholder="Search coffee, tea, gear..."
                               className="min-w-0 flex-1 rounded-full border border-stone-300 bg-stone-50 px-4 py-2 text-sm outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-200"
                               value={query.get()} onInput={e -> query.set(e.value())} />
                        <button id="cart-button"
                                className="relative rounded-full bg-amber-800 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700"
                                onClick={e -> cartOpen.set(true)}>
                            Cart
                            {cart.count() > 0
                                ? <span id="cart-count" className="ml-2 rounded-full bg-white px-2 py-0.5 text-xs font-bold text-amber-800">{cart.count()}</span>
                                : null}
                        </button>
                    </div>
                </header>

                <main className="mx-auto max-w-6xl px-4 py-8">
                    <div className="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <div className="flex flex-wrap gap-2">
                            {Catalog.CATEGORIES.stream().map(c ->
                                <button key={c} className={chipClass(c.equals(category.get()))}
                                        onClick={e -> category.set(c)}>{c}</button>
                            ).toList()}
                        </div>
                        <label className="flex items-center gap-2 text-sm text-stone-600">
                            Sort by
                            <select id="sort" className="rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm"
                                    value={sort.get()} onChange={e -> sort.set(e.value())}>
                                <option value="popular">Popular</option>
                                <option value="price-asc">Price: low to high</option>
                                <option value="price-desc">Price: high to low</option>
                                <option value="rating">Top rated</option>
                            </select>
                        </label>
                    </div>

                    <p id="result-count" className="mb-4 text-sm text-stone-500">{visible.size()} products</p>

                    {visible.isEmpty()
                        ? <div className="rounded-2xl border-2 border-dashed border-stone-300 p-12 text-center text-stone-500">
                              Nothing matches your search.
                          </div>
                        : <div className="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                              {visible.stream().map(p -> <ProductCard key={p.id()} product={p} />).toList()}
                          </div>}
                </main>

                <CartPanel open={cartOpen.get()} onClose={() -> cartOpen.set(false)} />
            </div>
        );
    }

    private static String chipClass(boolean active) {
        return active
            ? "rounded-full bg-amber-800 px-4 py-1.5 text-sm font-medium text-white"
            : "rounded-full bg-white px-4 py-1.5 text-sm font-medium text-stone-600 ring-1 ring-stone-300 hover:bg-stone-100";
    }
}
