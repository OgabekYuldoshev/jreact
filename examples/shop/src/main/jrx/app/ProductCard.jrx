package app;

import jreact.Component;
import jreact.Element;

/** One product tile. Reads the cart from context to show the quantity and to add itself. */
public class ProductCard extends Component<ProductCard.Props> {

    public record Props(Product product) {}

    @Override
    public Element render(Props props) {
        Cart cart = useContext(Cart.CONTEXT);
        Product p = props.product();
        int inCart = cart.quantity(p.id());

        return (
            <article className="product flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:shadow-md">
                <div className="flex h-32 items-center justify-center bg-gradient-to-br from-amber-50 to-orange-100 text-5xl">{p.emoji()}</div>
                <div className="flex flex-1 flex-col p-4">
                    <span className="text-xs font-medium uppercase tracking-wide text-amber-700">{p.category()}</span>
                    <h3 className="mt-1 font-semibold text-stone-800">{p.name()}</h3>
                    <p className="mt-1 text-sm text-stone-500">★ {Money.stars(p.rating())}</p>
                    <div className="mt-auto flex items-center justify-between pt-4">
                        <span className="text-lg font-bold text-stone-900">{Money.format(p.price())}</span>
                        <button className="add rounded-full bg-amber-800 px-4 py-1.5 text-sm font-semibold text-white hover:bg-amber-700 active:scale-95"
                                onClick={e -> cart.add().accept(p.id())}>
                            {inCart > 0 ? "Add another (" + inCart + ")" : "Add to cart"}
                        </button>
                    </div>
                </div>
            </article>
        );
    }
}
