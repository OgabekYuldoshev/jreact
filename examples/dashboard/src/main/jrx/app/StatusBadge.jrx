package app;

import jreact.Component;
import jreact.Element;

/** Coloured pill for an order status. */
public class StatusBadge extends Component<StatusBadge.Props> {

    public record Props(String status) {}

    @Override
    public Element render(Props props) {
        return <span className={"rounded-full px-2.5 py-0.5 text-xs font-medium " + color(props.status())}>{props.status()}</span>;
    }

    private static String color(String status) {
        return switch (status) {
            case "Paid" -> "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300";
            case "Pending" -> "bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300";
            default -> "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300";
        };
    }
}
