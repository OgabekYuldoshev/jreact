package app;

import java.util.List;
import jreact.Component;
import jreact.ErrorBoundary;
import jreact.Element;
import jreact.State;

/** Page shell: dark mode toggle, navigation, and the overview / orders / customers pages. */
public class Dashboard extends Component<Dashboard.Props> {

    public record Props() {}

    @Override
    public Element render(Props props) {
        State<Boolean> dark = useState(false);
        State<String> page = useState("overview");
        State<String> range = useState("7d");

        int[] series = Data.series(range.get());
        int revenue = 0;
        for (int v : series) revenue += v;
        int last = series[series.length - 1], prev = series[series.length - 2];
        int delta = (last - prev) * 100 / prev;
        boolean overview = page.get().equals("overview");

        return (
            <div id="theme-root" className={dark.get() ? "dark" : ""}>
                <div className="flex min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
                    <aside className="hidden w-56 shrink-0 flex-col border-r border-slate-200 bg-white p-4 md:flex dark:border-slate-800 dark:bg-slate-900">
                        <div className="mb-6 flex items-center gap-2 px-2 text-lg font-bold">
                            <span className="grid h-8 w-8 place-items-center rounded-lg bg-indigo-600 text-white">J</span>
                            Metrics
                        </div>
                        <Nav active={page.get()} vertical={true} onSelect={p -> page.set(p)} />
                    </aside>

                    <div className="min-w-0 flex-1">
                        <header className="flex items-center justify-between border-b border-slate-200 bg-white px-6 py-4 dark:border-slate-800 dark:bg-slate-900">
                            <h1 id="page-title" className="text-xl font-semibold capitalize">{page.get()}</h1>
                            <button id="theme-toggle"
                                    className="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
                                    onClick={e -> dark.update(d -> !d)}>
                                {dark.get() ? "☀ Light" : "☾ Dark"}
                            </button>
                        </header>
                        <div className="border-b border-slate-200 bg-white px-4 py-2 md:hidden dark:border-slate-800 dark:bg-slate-900">
                            <Nav active={page.get()} vertical={false} onSelect={p -> page.set(p)} />
                        </div>

                        <main className="space-y-6 p-6">
                            {overview
                                ? <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                                      <StatCard label="Revenue" value={"$" + revenue + "k"} delta={delta} />
                                      <StatCard label="Orders" value={"" + revenue / 2} delta={delta - 2} />
                                      <StatCard label="Customers" value={"" + revenue / 5} delta={delta + 3} />
                                      <StatCard label="Conversion" value="3.4%" delta={-1} />
                                  </div>
                                : null}

                            {overview
                                ? <div className="grid gap-6 lg:grid-cols-3">
                                      <div className="lg:col-span-2">
                                          <BarChart labels={Data.labels(range.get())} values={series} range={range.get()}
                                                    onRange={r -> range.set(r)} />
                                      </div>
                                      <ErrorBoundary fallback={(err, reset) ->
                                          <div id="widget-error" className="flex h-full flex-col items-center justify-center gap-3 rounded-2xl border border-rose-200 bg-rose-50 p-6 text-center dark:border-rose-900 dark:bg-rose-950">
                                              <p className="font-semibold text-rose-700 dark:text-rose-300">This widget crashed</p>
                                              <p className="text-sm text-rose-600 dark:text-rose-400">{err.getMessage()}</p>
                                              <button id="widget-reset" className="rounded-full bg-rose-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-rose-500"
                                                      onClick={e -> reset.run()}>Try again</button>
                                          </div>
                                      }>
                                          <TrafficWidget />
                                      </ErrorBoundary>
                                  </div>
                                : null}

                            {page.get().equals("customers")
                                ? <div className="rounded-2xl border-2 border-dashed border-slate-300 p-16 text-center text-slate-400 dark:border-slate-700">
                                      The customers page is not built yet.
                                  </div>
                                : <OrdersTable orders={Data.ORDERS} />}
                        </main>
                    </div>
                </div>
            </div>
        );
    }
}
