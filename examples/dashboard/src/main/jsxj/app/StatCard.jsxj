package app;

import jreact.Component;
import jreact.Element;

/** A KPI tile with a change badge: green for growth, red for a drop. */
public class StatCard extends Component<StatCard.Props> {

    public record Props(String label, String value, int delta) {}

    @Override
    public Element render(Props props) {
        boolean up = props.delta() >= 0;
        return (
            <div className="stat rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
                <p className="text-sm text-slate-500 dark:text-slate-400">{props.label()}</p>
                <div className="mt-2 flex items-end justify-between">
                    <span className="value text-2xl font-bold">{props.value()}</span>
                    <span className={up
                        ? "delta rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
                        : "delta rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700 dark:bg-rose-950 dark:text-rose-300"}>
                        {up ? "▲ " : "▼ "}{Math.abs(props.delta())}%
                    </span>
                </div>
            </div>
        );
    }
}
