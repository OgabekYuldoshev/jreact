<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven build: needed only for the browser build (TeaVM). The JDK-only ./build.sh keeps working without it. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.jreact</groupId>
    <artifactId>jreact-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JReact</name>
    <description>React internals in Java: .jsxj (JSX-like) syntax, Fiber reconciler, hooks, TeaVM browser build</description>
    <url>https://github.com/OgabekYuldoshev/jreact</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>OgabekYuldoshev</id>
            <name>Ogabek Yuldoshev</name>
            <url>https://github.com/OgabekYuldoshev</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/OgabekYuldoshev/jreact.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/OgabekYuldoshev/jreact.git</developerConnection>
        <url>https://github.com/OgabekYuldoshev/jreact</url>
    </scm>

    <modules>
        <module>jreact-core</module>
        <module>jreact-compiler</module>
        <module>jreact-maven-plugin</module>
        <module>jreact-scheduler</module>
        <module>jreact-reconciler</module>
        <module>jreact-router</module>
        <module>jreact-dom</module>
        <module>jreact-web</module>
    </modules>

    <!-- The example apps are not published. -Prelease switches this profile off (activeByDefault). -->
    <profiles>
        <profile>
            <id>examples</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <modules>
                <module>examples/todo-web</module>
                <module>examples</module>
            </modules>
        </profile>

        <!--
          Release to Maven Central:  mvn -Prelease -DskipTests deploy
          Needs a GPG key (maven-gpg-plugin) and a Central Portal token in ~/.m2/settings.xml under server id "central".
          Dry run (builds the sources/javadoc jars, no signing, no upload): mvn -Prelease -Dgpg.skip package
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration><doclint>none</doclint><quiet>true</quiet></configuration>
                        <executions><execution><id>javadoc</id><goals><goal>jar</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions><execution><id>sign</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- TeaVM reads class files, so emit Java 17 bytecode whatever JDK runs the build -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- the tests are dependency-free main() runners, ./build.sh test runs them -->
        <maven.test.skip>true</maven.test.skip>
        <teavm.version>0.16.0</teavm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-core</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-compiler</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-maven-plugin</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-scheduler</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-reconciler</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-router</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-dom</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>dev.jreact</groupId><artifactId>jreact-web</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso</artifactId><version>${teavm.version}</version></dependency>
            <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>${teavm.version}</version></dependency>
            <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso-impl</artifactId><version>${teavm.version}</version></dependency>
        </dependencies>
    </dependencyManagement>
</project>
