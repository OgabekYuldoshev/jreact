package {{package}}.client;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import jreact.router.*;
import jreact.web.Http;
import jreact.web.JReactWeb;
import jreact.web.Routers;
import {{package}}.shared.Todo;

public class WebMain {

    static List<Todo> todos(Object json) {
        List<Todo> out = new ArrayList<>();
        for (Object o : (List<?>) json) out.add(Todo.fromJson(o));
        return out;
    }

    public static void main(String[] args) {
        List<RouteObject> routes = List.of(
            RouteObject.of("/").id("todos").element(<TodoPage />).errorElement(<ErrorPage />)
                // runs in the browser before the page renders: asks the Spring Boot server
                .loader(a -> Http.get("/api/todos").then(WebMain::todos))
                // every <Form method="post"> on the page lands here; after it, the loader runs again
                .action(a -> {
                    SearchParams f = a.request().form();
                    String id = f.get("id", "");
                    switch (f.get("intent", "")) {
                        case "add": return Http.post("/api/todos", Map.of("title", f.get("title", "")));
                        case "toggle": return Http.patch("/api/todos/" + id, Map.of("done", "true".equals(f.get("done"))));
                        case "delete": return Http.delete("/api/todos/" + id);
                        default: throw new ErrorResponse(400, "Bad Request", "unknown intent");
                    }
                }));

        // real paths (/, /anything): the Spring Boot server answers every page URL with index.html
        JReactWeb.createRoot("root").render(<RouterProvider router={Routers.createBrowserRouter(routes)} fallbackElement={<p className="p-8 text-slate-500">Loading...</p>} />);
    }
}
