package {{package}}.client;

import java.util.List;
import dev.jreact.api.ClientApp;
import jreact.Element;
import jreact.router.*;
import {{package}}.shared.TodoApiClient;

/**
 * The routes of the app. The browser renders them (WebMain), and the Spring Boot server renders the first page from the very same
 * routes to HTML (jreact.ssr.app in the server's application.properties), so the page is there before any JavaScript runs.
 * Keep this class free of browser-only code: loaders call TodoApiClient, which works in both places.
 */
public class App implements ClientApp {

    @Override
    public List<RouteObject> routes() {
        return List.of(
            RouteObject.of("/").id("todos").element(<TodoPage />).errorElement(<ErrorPage />)
                // runs before the page renders, on the server for the first page and in the browser afterwards.
                // TodoApiClient is generated from the TodoApi interface in shared/: it calls the Spring Boot bean and returns a Promise<List<Todo>>
                .loader(a -> TodoApiClient.list())
                // every <Form method="post"> on the page lands here (in the browser); after it, the loader runs again
                .action(a -> {
                    SearchParams f = a.request().form();
                    switch (f.get("intent", "")) {
                        case "add": return TodoApiClient.add(f.get("title", ""));
                        case "toggle": return TodoApiClient.setDone(Long.parseLong(f.get("id", "0")), "true".equals(f.get("done")));
                        case "delete": return TodoApiClient.remove(Long.parseLong(f.get("id", "0")));
                        default: throw new ErrorResponse(400, "Bad Request", "unknown intent");
                    }
                }));
    }

    @Override
    public Element fallback() { return <p className="p-8 text-slate-500">Loading...</p>; }
}
